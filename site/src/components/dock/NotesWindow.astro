---
import TrafficLights from "@/components/dock/TrafficLights.astro";

const folders = [
  { name: "所有備忘錄", count: 12 },
  { name: "Harbor", count: 5, active: true },
  { name: "點子", count: 4 },
  { name: "垃圾桶", count: 1 },
];

const tasks = [
  { label: "圖示放大，曲線要順", done: true },
  { label: "最小化時顯示即時縮圖", done: true },
  { label: "工作列一定要能還原", done: true },
  { label: "閒置時 CPU 0%", done: true },
  { label: "繁體中文在地化", done: true },
  { label: "發布下一版", done: false },
];
---

<article class="note relative flex" data-note aria-label="記事本視窗預覽">
  <TrafficLights class="absolute top-3.5 left-4 z-1" />

  <aside class="hidden w-[158px] shrink-0 border-r border-black/8 px-3 pt-[52px] pb-3 md:block">
    <p class="px-1 text-[11px] font-bold text-black/45">資料夾</p>
    <ul class="mt-2 grid gap-0.5">
      {
        folders.map(({ name, count, active }) => (
          <li>
            <span
              class:list={[
                "flex items-center gap-2 squircle-xs px-1.5 py-1 text-[13px]",
                active ? "bg-[#0a84ff] text-white" : "text-[#1d1d1f]",
              ]}
            >
              <svg viewBox="0 0 16 12" class="size-3 shrink-0" aria-hidden="true">
                <path
                  d="M0 2.2C0 1.5.5 1 1.2 1h3.4l1.2 1.4h8c.7 0 1.2.5 1.2 1.2v7.2c0 .7-.5 1.2-1.2 1.2H1.2C.5 11.8 0 11.3 0 10.6V2.2Z"
                  fill={active ? "#ffffff" : "#f2b100"}
                />
              </svg>
              <span class="flex-1 truncate">{name}</span>
              <span class:list={["text-[11px]", active ? "text-white/80" : "text-black/40"]}>
                {count}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </aside>

  <div class="relative flex-1 px-5 pt-3 pb-4">
    <p class="text-center text-[13px] font-bold">備忘錄</p>
    <p class="mt-1 text-center text-[11px] text-black/38">2026年11月14日 星期五 上午 9:41</p>

    <h3 class="mt-4 text-[26px] leading-none tracking-[-0.04em] text-[#1d1d1f]">把 Dock 做出來。</h3>

    <ul class="mt-3 grid gap-2">
      {
        tasks.map(({ label, done }) => (
          <li class="flex items-center gap-2 text-[14px]">
            <span
              class:list={[
                "grid size-4 shrink-0 place-items-center circle",
                done ? "bg-[#ffb547]" : "border-[1.3px] border-black/25",
              ]}
            >
              {done && (
                <svg viewBox="0 0 12 12" class="size-2.5" aria-hidden="true">
                  <path
                    d="M1.4 6.4 4.4 9.4 10.6 2.6"
                    fill="none"
                    stroke="#fff"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                </svg>
              )}
            </span>
            <span class:list={[done ? "text-black/40" : "text-[#1d1d1f]"]}>{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>
