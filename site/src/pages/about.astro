---
import { Image } from "astro:assets";
import appIcon from "@/assets/brand/harbor-app.webp";
import Container from "@/components/layout/Container.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { author, site, upstream } from "@/data/site";
import { absoluteUrl, withBase } from "@/lib/url";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/showcase.css";

const description = `Harbor 是 ${author.name} 維護的 ${upstream.name} fork：免費、開源的 Windows macOS 風格 Dock，加入繁體中文在地化與多項改進。`;
const canonical = absoluteUrl("/about");

const makerLinks = [{ label: "GitHub", href: author.github }];

const upstreamLinks = [
  { label: `${upstream.name} 原始碼`, href: upstream.repository },
  { label: upstream.organization, href: upstream.organizationUrl },
  { label: upstream.author, href: upstream.authorUrl },
];

/** 這個 fork 和上游的主要差異，內容整理自 CHANGELOG 0.1.18 之後的版本。 */
const forkChanges = [
  "Dock、選單列、設定應用程式全面繁體中文化，官網、README 與更新紀錄也改用繁體中文。",
  "改名為 Harbor，從自己的 GitHub 倉庫發布，app 內自動更新也改從這裡下載。",
  "Dock 可放在螢幕左側、下方或右側，神燈速度可調，多視窗預覽卡片可直接關閉視窗。",
  "右鍵「結束工作」、需要注意的 app 紅點提示、系統匣釘選圖示與正在播放等選單列功能。",
  "神燈動畫不再閃爍、選單列閒置 CPU 約減三成，並修正多項工作列重現問題。",
];

const facts = [
  { label: "授權", value: site.license },
  { label: "程式語言", value: "Rust" },
  { label: "支援系統", value: "Windows 10／11" },
  { label: "目前版本", value: `v${site.version}` },
  { label: "上游專案", value: upstream.name },
];

const schema = [
  {
    "@type": "AboutPage",
    "@id": `${canonical}#page`,
    name: "關於 Harbor",
    url: canonical,
    description,
    isPartOf: { "@id": absoluteUrl("/#website") },
    about: { "@id": absoluteUrl("/#app") },
    author: { "@id": author.id },
    publisher: { "@id": author.id },
  },
  {
    "@type": "SoftwareSourceCode",
    "@id": `${site.repository}#code`,
    name: "Harbor 原始碼",
    codeRepository: site.repository,
    programmingLanguage: "Rust",
    license: `${site.repository}/blob/main/LICENSE`,
    isBasedOn: { "@type": "SoftwareSourceCode", name: upstream.name, codeRepository: upstream.repository },
    author: { "@id": author.id },
    publisher: { "@id": author.id },
    targetProduct: { "@id": absoluteUrl("/#app") },
  },
];
---

<BaseLayout title="關於 Harbor - Muelle 的繁體中文 fork" {description} product={false} {schema}>
  <SiteHeader />

  <main id="main" class="about pt-24 pb-10" data-about>
    <Container>
      <header class="intro" data-r>
        <Image src={appIcon} alt="" class="about-icon" width={112} height={112} />
        <p class="intro-eyebrow">關於</p>
        <h1 class="intro-title">站在 {upstream.name} 的肩膀上。</h1>
        <p class="intro-lead">
          Harbor 是 <a href={upstream.repository} target="_blank" rel="noopener noreferrer" class="about-inline">{upstream.name}</a>{" "}的 fork：一個讓 Windows 擁有 Mac 般 Dock 的免費工具。這個版本在原作的基礎上完成繁體中文在地化，並依照自己的使用習慣持續加入功能與修正。
        </p>
      </header>

      <section class="about-grid" aria-label="Harbor 的作者們">
        <article class="about-card about-maker" data-r>
          <p class="about-label">Fork 維護者</p>
          <div class="about-person">
            <img
              src={`${author.github}.png?size=160`}
              alt={author.name}
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
              class="about-avatar"
            />
            <div>
              <h2>{author.name}</h2>
              <p class="about-meta">{author.role}</p>
            </div>
          </div>
          <p>
            Harbor 由一位開發者維護，負責中文化、新功能與修正，並從自己的倉庫發布版本。問題回報與功能建議請發到 Harbor 的 GitHub Issues，不要打擾上游。
          </p>
          <ul class="about-links">
            {
              makerLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer me">
                    {link.label}
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="about-card" data-r>
          <p class="about-label">原始專案</p>
          <div>
            <h2>{upstream.name}</h2>
            <p class="about-meta">{upstream.organization} · {upstream.author}</p>
          </div>
          <p>
            Dock、選單列、神燈效果、螃蟹吉祥物與設定應用程式的核心設計都來自 {upstream.name}。原作以 MIT 授權開源，Harbor 才能在此基礎上延伸，衷心感謝原作者與所有貢獻者。
          </p>
          <ul class="about-links">
            {
              upstreamLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                </li>
              ))
            }
          </ul>
        </article>
      </section>

      <section class="about-card about-changes" aria-labelledby="fork-changes" data-r>
        <p class="about-label">這個 fork 改了什麼</p>
        <h2 id="fork-changes">中文化，加上一些順手的改進。</h2>
        <ul class="about-change-list">
          {forkChanges.map((change) => <li>{change}</li>)}
        </ul>
        <a class="about-secondary" href={withBase("/changelog")}>
          看完整更新紀錄
          <Icon name="arrow-right" size={14} />
        </a>
      </section>

      <section class="about-card about-open" aria-labelledby="open-source" data-r>
        <div>
          <p class="about-label">開放原始碼</p>
          <h2 id="open-source">看得到、建得起來、改得動。</h2>
          <p>
            Harbor 的所有程式碼都以 {site.license} 授權放在 GitHub 上。你可以從原始碼建置安裝檔、檢查它實際送出哪些網路請求，也歡迎送修正過來。
          </p>
          <p>
            依照 MIT 授權，LICENSE 檔保留了 {upstream.name} contributors 的原始版權聲明，上游的完整授權條款另收錄在 THIRD-PARTY-NOTICES.md，安裝檔也會一併附上。
          </p>
          <div class="about-actions">
            <Button href={site.repository}>
              查看原始碼
              <Icon name="github" size={18} />
            </Button>
            <a class="about-secondary" href={withBase("/changelog")}>
              閱讀更新紀錄
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
        <dl class="about-facts">
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </Container>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .about-icon {
    width: 112px;
    height: 112px;
    margin: 0 auto 28px;
  }

  .about-grid {
    display: grid;
    /* 維護者與上游各一張卡片並排，讓 fork 關係一眼可見 */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 88px;
  }
  .about-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    border: 1px solid var(--color-line);
    border-radius: 28px;
    background: var(--color-card);
    line-height: 1.6;
  }
  .about-card h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
  }
  .about-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .about-person {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .about-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--color-card), var(--color-card)) padding-box,
      var(--gradient-primary) border-box;
  }
  .about-meta {
    margin-top: 4px;
    font-size: 14px;
    color: var(--color-mute);
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }
  .about-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 14px;
    transition:
      border-color 180ms ease-out,
      color 180ms ease-out;
  }
  .about-links a:hover {
    border-color: var(--color-primary);
    color: var(--color-signal);
  }

  .about-changes {
    margin-top: 20px;
  }
  .about-change-list {
    display: grid;
    gap: 10px;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .about-changes .about-secondary {
    align-self: flex-start;
  }

  .about-open {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
    margin-top: 20px;
  }
  .about-open > div {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 8px;
  }
  .about-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .about-secondary:hover {
    color: var(--color-signal);
  }
  .about-inline {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .about-inline:hover {
    color: var(--color-signal);
  }
  .about-facts {
    display: grid;
    align-content: center;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    overflow: hidden;
  }
  .about-facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
  }
  .about-facts div + div {
    border-top: 1px solid var(--color-line);
  }
  .about-facts dt {
    color: var(--color-mute);
  }
  .about-facts dd {
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .about-grid,
    .about-open {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-card {
      padding: 24px;
    }
  }
</style>

<script>
  import { initReveal } from "@/scripts/reveal";

  const root = document.querySelector<HTMLElement>("[data-about]");
  if (root) initReveal(root);
</script>
