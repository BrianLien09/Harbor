---
import { Image } from "astro:assets";
import appIcon from "@/assets/brand/harbor-app.webp";
import Container from "@/components/layout/Container.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { author, site, upstream } from "@/data/site";
import { absoluteUrl, withBase } from "@/lib/url";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/showcase.css";

const description = `Harbor is a free, open-source macOS-style dock for Windows, maintained by ${author.name}, and based on ${upstream.name} by ${upstream.organization}.`;
const canonical = absoluteUrl("/about");

const makerLinks = [{ label: "GitHub", href: author.github }];

const facts = [
  { label: "License", value: site.license },
  { label: "Written in", value: "Rust" },
  { label: "Runs on", value: "Windows 10 and 11" },
  { label: "Current version", value: `v${site.version}` },
];

const schema = [
  {
    "@type": "AboutPage",
    "@id": `${canonical}#page`,
    name: "About Harbor",
    url: canonical,
    description,
    isPartOf: { "@id": absoluteUrl("/#website") },
    about: { "@id": absoluteUrl("/#app") },
    author: { "@id": author.id },
    publisher: { "@id": author.id },
  },
  {
    "@type": "SoftwareSourceCode",
    "@id": `${site.repository}#code`,
    name: "Harbor source code",
    codeRepository: site.repository,
    programmingLanguage: "Rust",
    license: `${site.repository}/blob/main/LICENSE`,
    author: { "@id": author.id },
    publisher: { "@id": author.id },
    targetProduct: { "@id": absoluteUrl("/#app") },
  },
];
---

<BaseLayout title="About Harbor - an open-source dock for Windows" {description} product={false} {schema}>
  <SiteHeader />

  <main id="main" class="about pt-24 pb-10" data-about>
    <Container>
      <header class="intro" data-r>
        <Image src={appIcon} alt="" class="about-icon" width={112} height={112} />
        <p class="intro-eyebrow">About</p>
        <h1 class="intro-title">Built in the open.</h1>
        <p class="intro-lead">
          Harbor is a free dock for Windows that feels like the one on a Mac. It is a fork of Muelle, whose name is the
          Spanish word for a dock where boats come in.
        </p>
      </header>

      <section class="about-grid" aria-label="Who makes Harbor">
        <article class="about-card about-maker" data-r>
          <p class="about-label">The maker</p>
          <div class="about-person">
            <img
              src={`${author.github}.png?size=160`}
              alt={author.name}
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
              class="about-avatar"
            />
            <div>
              <h2>{author.name}</h2>
              <p class="about-meta">{author.role}</p>
            </div>
          </div>
          <p>
            Harbor is a personal fork of Muelle that adds a Traditional Chinese interface and keeps the dock, the
            Settings app and the website in sync with the original.
          </p>
          <ul class="about-links">
            {
              makerLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer me">
                    {link.label}
                    <Icon name="arrow-up-right" size={12} />
                  </a>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="about-card" data-r>
          <p class="about-label">Based on</p>
          <h2>{upstream.name}</h2>
          <p>
            Harbor is built on {upstream.name}, an MIT-licensed project by {upstream.author} and {upstream.organization}.
            The original design, code and icons belong to them.
          </p>
          <ul class="about-links">
            <li>
              <a href={upstream.repository} target="_blank" rel="noopener noreferrer">
                {upstream.name} on GitHub
                <Icon name="arrow-up-right" size={12} />
              </a>
            </li>
            <li>
              <a href={upstream.organizationUrl} target="_blank" rel="noopener noreferrer">
                {upstream.organization}
                <Icon name="arrow-up-right" size={12} />
              </a>
            </li>
          </ul>
        </article>
      </section>

      <section class="about-card about-open" aria-labelledby="open-source" data-r>
        <div>
          <p class="about-label">Open source</p>
          <h2 id="open-source">Read it, build it, change it.</h2>
          <p>
            All of Harbor is on GitHub under the {site.license} license. You can build the installer from source, read
            exactly what it sends over the network, and send a fix. Community pull requests already ship in releases.
          </p>
          <div class="about-actions">
            <Button href={site.repository}>
              View the source
              <Icon name="github" size={18} />
            </Button>
            <a class="about-secondary" href={withBase("/changelog")}>
              Read the changelog
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
        <dl class="about-facts">
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </Container>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .about-icon {
    width: 112px;
    height: 112px;
    margin: 0 auto 28px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 88px;
  }
  .about-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    border: 1px solid var(--color-line);
    border-radius: 28px;
    background: var(--color-card);
    line-height: 1.6;
  }
  .about-card h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
  }
  .about-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .about-person {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .about-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid transparent;
    background:
      linear-gradient(var(--color-card), var(--color-card)) padding-box,
      var(--gradient-primary) border-box;
  }
  .about-meta {
    margin-top: 4px;
    font-size: 14px;
    color: var(--color-mute);
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }
  .about-links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 14px;
    transition:
      border-color 180ms ease-out,
      color 180ms ease-out;
  }
  .about-links a:hover {
    border-color: var(--color-primary);
    color: var(--color-signal);
  }

  .about-open {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
    margin-top: 20px;
  }
  .about-open > div {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 8px;
  }
  .about-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .about-secondary:hover {
    color: var(--color-signal);
  }
  .about-facts {
    display: grid;
    align-content: center;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    overflow: hidden;
  }
  .about-facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
  }
  .about-facts div + div {
    border-top: 1px solid var(--color-line);
  }
  .about-facts dt {
    color: var(--color-mute);
  }
  .about-facts dd {
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .about-grid,
    .about-open {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-card {
      padding: 24px;
    }
  }
</style>

<script>
  import { initReveal } from "@/scripts/reveal";

  const root = document.querySelector<HTMLElement>("[data-about]");
  if (root) initReveal(root);
</script>
